{
  "name": "@my-knowledge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm types && next dev",
    "build": "pnpm types && next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "seed:local": "node __test__/scripts/seed-local.ts",
    "test:mcp": "node __test__/scripts/mcp-contract.ts http://localhost:8787/api/mcp",
    "dry-run": "wrangler deploy --dry-run --config wrangler.json",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "types": "wrangler types node_modules/.wrangler-types.d.ts --env-interface CloudflareEnv && next typegen"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@my-knowledge/content": "workspace:*",
    "@my-knowledge/ui": "workspace:*",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-placeholder": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "katex": "0.18.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "wrangler": "4.125.0"
  }
}
