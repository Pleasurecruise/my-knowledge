{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-knowledge",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": {
    "cpu_ms": 300000
  },
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "knowledge.you-find.me",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://knowledge.you-find.me",
    "CF_ACCOUNT_ID": "fb71c4eceaf623ae1b19b8b37d7a38cf"
  },
  "secrets": {
    "required": [
      "ALLOWED_EMAIL",
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "CF_AIG_TOKEN",
      "MCP_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-knowledge-v2",
      "database_id": "b75b2946-eed6-448a-8fb0-7f8a60f3ceda",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_BUCKET",
      "bucket_name": "cherry-studio",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KNOWLEDGE_CACHE",
      "id": "dc4f4d89276e40d2a82479cfc7867b5d",
      "remote": true
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ARTICLE_JOBS",
        "queue": "article-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "article-jobs",
        "max_batch_size": 1
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
