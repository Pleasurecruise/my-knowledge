{
  "name": "my-knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @my-knowledge/web dev",
    "build": "pnpm --filter @my-knowledge/web build:worker",
    "preview": "pnpm --filter @my-knowledge/web preview",
    "deploy": "pnpm --filter @my-knowledge/web deploy",
    "dry-run": "pnpm --filter @my-knowledge/web dry-run",
    "d1:migrate:local": "pnpm --filter @my-knowledge/web exec wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.json",
    "d1:migrate:remote": "pnpm --filter @my-knowledge/web exec wrangler d1 migrations apply DB --remote --config wrangler.json",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "test:mcp": "pnpm --filter @my-knowledge/web test:mcp",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm --filter @my-knowledge/web types && vp check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0-rc.0"
  },
  "packageManager": "pnpm@12.4.2"
}
